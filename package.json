{
  "name": "ribbits-big-adventure",
  "version": "1.0.0",
  "description": "Ribbit's Big Adventure - Retro platformer for Web and Desktop",
  "scripts": {
    "build": "vite build",
    "check": "node tools/check-project.js && node tools/validate-level-data.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src/web tools server.js vite.config.mjs playwright.config.js",
    "format:check": "prettier --check package.json vite.config.mjs playwright.config.js src/web/entry-2d.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run check && node tools/save-data-smoke.js && node tools/server-smoke.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "game",
    "platformer",
    "phaser",
    "retro",
    "pixel-art"
  ],
  "author": "spinz",
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "eslint": "10.8.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}
